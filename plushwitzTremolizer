desc:plushwitzTremolizer

slider1:trigger_cc=64<1,127,1>Trigger CC
slider2:cc_ch=1<1, 16, 1>CC channel
slider3:notes_ch=1<1, 16, 1>Notes channel


@init
  freemem = 0;
  engaged = 0;

  on_velocities = freemem;
  i = 0;
  loop(128,
    on_velocities[i] = 0;
    i += 1;
  );
  freemem += 128;

  true_ons = freemem;
  i = 0;
  loop(128,
    true_ons[i] = 0;
    i += 1;
  );
  freemem += 128;
  all_ons = freemem;
  i = 0;
  loop(128,
    all_ons[i] = 0;
    i += 1;
  );
  freemem += 128;

@block
  target_cc_channel_byte = $xB0 + cc_ch - 1;
  target_note_on_channel_byte = $x90 + notes_ch - 1;
  target_note_off_channel_byte = $x80 + notes_ch - 1;

  while (midirecv(offset,msg1,msg2,msg3)) (
    msg1 == target_cc_channel_byte && msg2 == trigger_cc ? (
      msg3 > 63 ? (
        engaged = 1;
      ) :
      engaged ? (
        engaged = 0;
        
        i = 1;
        while (i < 128) (
          (all_ons[i] && !true_ons[i]) ? (
            all_ons[i] = 0;
            midisend(offset, $x80, i, 0);
          );
          i += 1;
        );
      )
    ) :
    msg1 == target_note_on_channel_byte && msg3 != 0 ? (
      on_velocities[msg2] = msg3;
      true_ons[msg2] = 1;
      all_ons[msg2] = 1;
      midisend(offset, msg1, msg2, msg3);
    ) :
    engaged && (msg1 == target_note_off_channel_byte) ? (
      true_ons[msg2] = 0;
      all_ons[msg2] = 1;
      midisend(offset, target_note_off_channel_byte, msg2, msg3);
      midisend(offset, target_note_on_channel_byte, msg2, msg3);
    ) :
    engaged & (msg1 == target_note_on_channel_byte && msg3 == 0) ? (
      true_ons[msg2] = 0;
      all_ons[msg2] = 1;
      midisend(offset, target_note_off_channel_byte, msg2, on_velocities[msg2]);
      midisend(offset, target_note_on_channel_byte, msg2, on_velocities[msg2]);
    ) :
    (
      !engaged && (msg1 == target_note_off_channel_byte || (msg1 == target_note_on_channel_byte && msg3 == 0)) ? (
        true_ons[msg2] = 0;
        all_ons[msg2] = 0;
      );
      midisend(offset, msg1, msg2, msg3);
    );
  );
